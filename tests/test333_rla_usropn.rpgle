**FREE
// OPEN, CLOSE and %OPEN on a USROPN file read through the database: a
// file closed and opened again reads from its first record.
DCL-F CUSTFL104 DISK EXTDESC('CUSTFL104') USROPN;

DCL-S connStr VARCHAR(200);

connStr = 'Driver={SQLite3};Database=/tmp/rpgc_test333.sqlite;';
/IF DEFINED(*OPENRPG)
EXEC SQL CONNECT USING :connStr;
/ENDIF
EXEC SQL DROP TABLE IF EXISTS custfl104;
EXEC SQL CREATE TABLE custfl104 (
  CUSTNO VARCHAR(10),
  CUSTNAME VARCHAR(50),
  CUSTBAL DECIMAL(9,2)
);
EXEC SQL INSERT INTO custfl104 VALUES('A001','Alice',100.00);
EXEC SQL INSERT INTO custfl104 VALUES('A002','Bob',200.00);

IF NOT %OPEN(CUSTFL104);
  DSPLY 'not open';
ENDIF;
MONITOR;
  READ CUSTFL104;
ON-ERROR;
  DSPLY ('READ before OPEN: ' + %CHAR(%STATUS));
ENDMON;
OPEN CUSTFL104;
READ CUSTFL104;
DSPLY CUSTNAME;
READ CUSTFL104;
DSPLY CUSTNAME;
OPEN(E) CUSTFL104;
DSPLY ('OPEN again: ' + %CHAR(%STATUS));
CLOSE CUSTFL104;
IF NOT %OPEN(CUSTFL104);
  DSPLY 'closed';
ENDIF;
OPEN CUSTFL104;
READ CUSTFL104;
DSPLY CUSTNAME;
CLOSE CUSTFL104;

EXEC SQL DROP TABLE custfl104;
/IF DEFINED(*OPENRPG)
EXEC SQL DISCONNECT;
/ENDIF
*INLR = *ON;
